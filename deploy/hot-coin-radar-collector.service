[Unit]
Description=Hot Coin Radar collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hot-coin-radar
EnvironmentFile=/opt/hot-coin-radar/.env
ExecStart=/opt/hot-coin-radar/.venv/bin/python -m radar collector
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

